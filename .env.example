# ---------------------------------------------------------------
# MODO DEMO: no hace falta rellenar nada. La app funciona entera,
# pero los datos pueden borrarse y los correos no se envían de verdad.
# Rellena esto para usarla "en serio".
# ---------------------------------------------------------------

# 1) Base de datos (Turso, gratis): https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 2) Correo (Resend): https://resend.com  -> hay que verificar un dominio
RESEND_API_KEY=
MAIL_FROM="AutoMailX <hola@tudominio.com>"

# 3) IA (Anthropic): https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# 4) Recordatorio semanal (cron de Vercel). Pon una frase larga cualquiera.
CRON_SECRET=

# Opcional: tu dirección pública si usas dominio propio (sin barra final)
# APP_URL=https://tudominio.com
