# ---------------------------------------------------------------
# AutoMailX necesita una base de datos para funcionar.
# ---------------------------------------------------------------

# 1) Base de datos (Supabase, Postgres)
# Si conectas Supabase desde Vercel (Storage), esto se añade solo como POSTGRES_URL.
# Si no, pega aquí la dirección "Transaction pooler" que sale en Supabase > Connect.
DATABASE_URL=

# 2) Entrada directa de pruebas. Pon 1 SOLO mientras pruebas tú sola/o: muestra el enlace
#    de acceso en pantalla en vez de enviarlo por correo. Quítala al usarlo con gente real.
ALLOW_DEMO_LOGIN=

# 3) Correo (Resend): https://resend.com  -> para escribir a otras personas hay que verificar un dominio
RESEND_API_KEY=
MAIL_FROM="AutoMailX <hola@tudominio.com>"

# 4) IA (Anthropic): https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# 5) Recordatorio semanal (cron de Vercel). Pon una frase larga cualquiera.
CRON_SECRET=

# Opcional: tu dirección pública si usas dominio propio (sin barra final)
# APP_URL=https://tudominio.com
