# ------------------------------------------------------------------
# Variables de AutoMailX. En Vercel: Settings > Environment Variables.
# ------------------------------------------------------------------

# 1) Base de datos (Supabase). Si conectaste Supabase desde Vercel, ya están puestas solas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 2) IA (Anthropic) -> https://console.anthropic.com  (Settings > API Keys)
#    Sin esta clave los borradores van en "modo simulado" y no escriben bien.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_POLISH=0      (apaga el segundo pase de "editor jefe": gasta menos, escribe peor)

# 3) Correo (Resend) -> https://resend.com  (API Keys)
#    Con el remitente de pruebas solo puedes escribir a tu propio correo.
#    Para escribir a otras personas, verifica un dominio en Resend > Domains y cambia MAIL_FROM.
RESEND_API_KEY=
MAIL_FROM="AutoMailX <onboarding@resend.dev>"

# 4) Crons (temas programados y recordatorio semanal). Una frase larga cualquiera.
CRON_SECRET=

# 5) Entrada directa SOLO para tus pruebas (muestra el enlace en pantalla en vez de enviarlo).
#    Bórrala antes de abrir la web al público.
# ALLOW_DEMO_LOGIN=1

# Opcional: tu dirección pública si usas dominio propio (sin barra final)
# APP_URL=https://tudominio.com
